<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <PackageId>JGUZDV.Extensions.OpenTelemetry</PackageId>
        <IsPackable>true</IsPackable>
        <Version>1.2.0</Version>
        <Authors>Tobias Beckhoff, Thomas Ottenhus, Agim Shabani</Authors>
        <Company>Zentrum für Datenverarbeitung - JGU Mainz</Company>
        <PackageDescription>Extensions to observe applications via Azure Monitor and OpenTelemetry.</PackageDescription>

        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <OtelVersion>1.20.1</OtelVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.0,)" />

        <PackageReference Include="OpenTelemetry" Version="$(OtelVersion)" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="$(OtelVersion)" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OtelVersion)" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="$(OtelVersion)" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OtelVersion)" />
        <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="$(OtelVersion)" />
        
        <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    </ItemGroup>
</Project>