<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(Net10Version)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(Net10Version)" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="$(Net10Version)" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(Net10Version)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\JGUZDV.Blazor.Components.Samples.csproj" />
    </ItemGroup>

</Project>
