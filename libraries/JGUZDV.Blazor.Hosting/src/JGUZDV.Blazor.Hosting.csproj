<Project Sdk="Microsoft.NET.Sdk.Razor">
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>

        <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>

        <PackageId>JGUZDV.Blazor.Hosting</PackageId>
        <IsPackable>true</IsPackable>
        <Version>1.2.0</Version>
        <Authors>Thomas Ottenhus</Authors>
        <Company>Zentrum für Datenverarbeitung - JGU Mainz</Company>
        <PackageDescription>HostBuilders for our default setup.</PackageDescription>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>

        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="[$(Net10Version), )" PrivateAssets="All" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="[$(Net10Version), )" PrivateAssets="All" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="[$(Net10Version),)" />
        <PackageReference Include="Microsoft.FeatureManagement" Version="[4.8.0, )" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\JGUZDV.AspNetCore.Components.Localization\src\JGUZDV.AspNetCore.Components.Localization.csproj" />
    </ItemGroup>
</Project>
